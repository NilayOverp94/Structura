# ==============================================
# Structura - Environment Variables Template
# Copy this file to .env.local and fill in your values
# ==============================================

# --- Supabase ---
# Get these from your Supabase project settings > API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key - NEVER expose to the browser
# Used for server-side operations only
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub ---
# Create a personal access token at https://github.com/settings/tokens
# Required scopes: public_repo (for reading public repos)
GITHUB_TOKEN=
# OAuth App credentials (optional, for GitHub login)
# Create at https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Google Gemini AI ---
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Model names (defaults shown)
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
